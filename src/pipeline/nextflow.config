/*
========================================================================================
    Nextflow Configuration for Metagenomics Pipeline
========================================================================================
*/

params {
    input               = "/net/scratch/hscra/plgrid/plgpkica/metagenome_proj/data/test.csv"
    indir               = "/net/storage/pr3/plgrid/plgggutmap/input_mg/input_dataset"
    outdir              = "/net/storage/pr3/plgrid/plgggutmap/output_mg/test"
    bowtie2_hg38_index  = "/net/scratch/hscra/plgrid/plgpkica/metagenome_proj/databases/hg38_reference/hg38"
    sylph_db            = "/net/scratch/hscra/plgrid/plgpkica/metagenome_proj/databases/gtdb-r226-c200-dbv1.syldb"
    bakta_db            = "/net/scratch/hscra/plgrid/plgpkica/metagenome_proj/databases/bakta_db_v6"
    limit               = 100
    trace_timestamp     = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

profiles {
    standard {
        process {
            executor       = 'slurm'
            queue          = 'plgrid'
            clusterOptions = '-A plggutmap100k-cpu'
            time           = '4h'
            withName: 'SYLPH_TAXONOMY|BAKTA_ANNOTATION|CHECKM_QA|FILTER_AND_ANNOTATE' {
                queue          = 'plgrid-bigmem'
                clusterOptions = '-A plggutmap100k-cpu-bigmem'
            }
            withName: MEGAHIT_ASSEMBLY {
                clusterOptions = '-A plggutmap100k-cpu -C memfs'
            }
        }
        executor {
            queueSize       = 950
            submitRateLimit = '10sec'
        }
    }
}

process {
    errorStrategy = 'ignore'
    cpus          = 1
    memory        = '4 GB'
}

conda {
    enabled = true
    channels = ['conda-forge', 'bioconda']
    cacheDir = "/net/scratch/hscra/plgrid/plgpkica/metagenome_proj/conda"
}
env {
    CHECKM2DB = "/net/scratch/hscra/plgrid/plgpkica/metagenome_proj/databases/checkm2_db/CheckM2_database/uniref100.KO.1.dmnd"
    GTDBTK_DATA_PATH = "/net/scratch/hscra/plgrid/plgpkica/metagenome_proj/databases/gtdbtk_db/release226"
}

//cleanup = true
workDir = '/net/storage/pr3/plgrid/plgggutmap/nf_work'

timeline {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/${params.trace_timestamp}/execution_timeline.html"
}
report {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/${params.trace_timestamp}/execution_report.html"
}
trace {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/${params.trace_timestamp}/execution_trace.tsv"
    raw     = true
    fields  = 'task_id,hash,native_id,process,tag,name,status,exit,attempt,error_action,cpus,memory,time,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,read_bytes,write_bytes,workdir'
}
dag {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/${params.trace_timestamp}/pipeline_dag.html"
}

